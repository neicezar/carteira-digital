# Configurações do Banco de Dados PostgreSQL (Serviço Contas)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=contas_db
DB_USER=contas_user
DB_PASSWORD=contas_pass

# String de Conexão JDBC / Aplicação
# Exemplo para Spring Boot / Java:
# SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
